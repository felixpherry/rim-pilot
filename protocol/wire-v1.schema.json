{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rim-pilot:wire:1",
  "title": "Rim-pilot wire v1 (schema availability is not route implementation)",
  "oneOf": [{"$ref":"#/$defs/request"},{"$ref":"#/$defs/success"},{"$ref":"#/$defs/failure"}],
  "$defs": {
    "requestId":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
    "session":{"type":"string","pattern":"^s_[0-9a-f]{32}$"},
    "root":{"type":"string","pattern":"^r_[0-9a-f]{32}$"},
    "game":{"type":"string","pattern":"^g_[0-9a-f]{32}$"},
    "map":{"type":"string","pattern":"^m_[0-9a-f]{32}$"},
    "capture":{"type":"string","pattern":"^c_[0-9a-f]{32}$"},
    "pawnId":{"type":"string","pattern":"^p_[0-9a-f]{32}$"},
    "thingId":{"type":"string","pattern":"^t_[0-9a-f]{32}$"},
    "pageCursor":{"type":"string","pattern":"^q_[0-9a-f]{32}$"},
    "eventCursor":{"type":"string","pattern":"^e_[0-9a-f]{32}$"},
    "label":{"type":"string","maxLength":512,"description":"Also <=512 UTF-16 code units; JSON preflight rejects unpaired surrogates."},
    "symbol":{"type":"string","maxLength":64},
    "counter":{"type":"integer","minimum":0,"maximum":9223372036854775807},
    "scope":{"type":"object","additionalProperties":false,"required":["session","root"],"properties":{"session":{"$ref":"#/$defs/session"},"root":{"$ref":"#/$defs/root"},"game":{"$ref":"#/$defs/game"},"map":{"$ref":"#/$defs/map"}},"dependentRequired":{"map":["game"]}},
    "mapScope":{"allOf":[{"$ref":"#/$defs/scope"},{"required":["game","map"]}]},
    "sample":{"type":"object","additionalProperties":false,"required":["scope","capture","frame","phase"],"properties":{"scope":{"$ref":"#/$defs/scope"},"capture":{"$ref":"#/$defs/capture"},"frame":{"$ref":"#/$defs/counter"},"phase":{"const":"root_update_postfix"},"tick":{"$ref":"#/$defs/counter"}},"allOf":[{"if":{"required":["tick"]},"then":{"properties":{"scope":{"required":["game"]}}}}],"description":"tick only with game; frame does not mean completed rendering or atomic cross-frame snapshot."},
    "mapSample":{"allOf":[{"$ref":"#/$defs/sample"},{"properties":{"scope":{"required":["game","map"]}}}]},
    "emptyParams":{"type":"object","additionalProperties":false},
    "scopeParams":{"type":"object","additionalProperties":false,"required":["scope"],"properties":{"scope":{"$ref":"#/$defs/scope"}}},
    "mapParams":{"type":"object","additionalProperties":false,"required":["scope"],"properties":{"scope":{"$ref":"#/$defs/mapScope"}}},
    "pageParams":{"type":"object","additionalProperties":false,"required":["scope","limit"],"properties":{"scope":{"$ref":"#/$defs/mapScope"},"limit":{"type":"integer","minimum":1,"maximum":64},"cursor":{"$ref":"#/$defs/pageCursor"}}},
    "eventParams":{"type":"object","additionalProperties":false,"required":["scope","limit"],"properties":{"scope":{"$ref":"#/$defs/scope"},"limit":{"type":"integer","minimum":1,"maximum":64},"cursor":{"$ref":"#/$defs/eventCursor"}}},
    "authParams":{"type":"object","additionalProperties":false,"required":["session","token"],"properties":{"session":{"$ref":"#/$defs/session"},"token":{"type":"string","pattern":"^[0-9a-f]{64}$","writeOnly":true}}},
    "pawnParams":{"type":"object","additionalProperties":false,"required":["scope","pawn"],"properties":{"scope":{"$ref":"#/$defs/mapScope"},"pawn":{"$ref":"#/$defs/pawnId"}}},
    "request":{"type":"object","additionalProperties":false,"required":["v","id","method","params"],"properties":{"v":{"const":1},"id":{"$ref":"#/$defs/requestId"},"method":{"enum":["auth","health","capabilities","summary","pawns.list","pawn.get","things.list","resources","ui","screenshot","events.read"]},"params":{"type":"object"}},"allOf":[
      {"if":{"properties":{"method":{"const":"auth"}}},"then":{"properties":{"params":{"$ref":"#/$defs/authParams"}}}},
      {"if":{"properties":{"method":{"enum":["health","capabilities"]}}},"then":{"properties":{"params":{"$ref":"#/$defs/emptyParams"}}}},
      {"if":{"properties":{"method":{"enum":["summary","ui","screenshot"]}}},"then":{"properties":{"params":{"$ref":"#/$defs/scopeParams"}}}},
      {"if":{"properties":{"method":{"enum":["pawns.list","things.list"]}}},"then":{"properties":{"params":{"$ref":"#/$defs/pageParams"}}}},
      {"if":{"properties":{"method":{"const":"resources"}}},"then":{"properties":{"params":{"$ref":"#/$defs/mapParams"}}}},
      {"if":{"properties":{"method":{"const":"pawn.get"}}},"then":{"properties":{"params":{"$ref":"#/$defs/pawnParams"}}}},
      {"if":{"properties":{"method":{"const":"events.read"}}},"then":{"properties":{"params":{"$ref":"#/$defs/eventParams"}}}}
    ]},
    "errorCode":{"enum":["invalid_frame","invalid_json","invalid_request","version_mismatch","authentication_failed","forbidden_method","unsupported_method","not_ready","observation_refused","unavailable","stale_scope","cursor_expired","event_gap","busy","rate_limited","timeout","response_too_large","internal_error"]},
    "failure":{"type":"object","additionalProperties":false,"required":["v","ok","error"],"properties":{"v":{"const":1},"id":{"$ref":"#/$defs/requestId"},"ok":{"const":false},"error":{"type":"object","additionalProperties":false,"required":["code"],"properties":{"code":{"$ref":"#/$defs/errorCode"}}}}},
    "success":{"type":"object","additionalProperties":false,"required":["v","id","ok","data"],"properties":{"v":{"const":1},"id":{"$ref":"#/$defs/requestId"},"ok":{"const":true},"data":{"oneOf":[{"$ref":"#/$defs/authData"},{"$ref":"#/$defs/healthData"},{"$ref":"#/$defs/capabilityData"},{"$ref":"#/$defs/summary"},{"$ref":"#/$defs/pawnData"},{"$ref":"#/$defs/page"},{"$ref":"#/$defs/resources"},{"$ref":"#/$defs/ui"},{"$ref":"#/$defs/screenshot"},{"$ref":"#/$defs/eventPage"}]}}},
    "authData":{"type":"object","additionalProperties":false,"required":["session","protocol"],"properties":{"session":{"$ref":"#/$defs/session"},"protocol":{"const":1}}},
    "healthData":{"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"enum":["bootstrap","loading","ready","stopping"]},"scope":{"$ref":"#/$defs/scope"}}},
    "capability":{"type":"object","additionalProperties":false,"required":["name","state","schema"],"properties":{"name":{"$ref":"#/$defs/symbol"},"state":{"enum":["available","unsupported","unverified"]},"schema":{"$ref":"#/$defs/symbol"},"reason":{"type":"string","maxLength":256}}},
    "capabilityData":{"type":"object","additionalProperties":false,"required":["capabilities"],"properties":{"capabilities":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/capability"},"description":"Names unique; unsupported fields absent, never zero-valued substitutes."}}},
    "manifestEntry":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","maxLength":256},"label":{"$ref":"#/$defs/label"},"version":{"$ref":"#/$defs/symbol"}}},
    "mapSummary":{"type":"object","additionalProperties":false,"required":["map","label"],"properties":{"map":{"$ref":"#/$defs/map"},"label":{"$ref":"#/$defs/label"},"width":{"type":"integer","minimum":1,"maximum":4096},"height":{"type":"integer","minimum":1,"maximum":4096},"eligibleOwnPawns":{"type":"integer","minimum":0,"maximum":2048}}},
    "summary":{"type":"object","additionalProperties":false,"required":["sample","scene","build"],"properties":{"sample":{"$ref":"#/$defs/sample"},"scene":{"enum":["menu","playing"]},"build":{"$ref":"#/$defs/label"},"paused":{"type":"boolean"},"currentMap":{"$ref":"#/$defs/map"},"maps":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/mapSummary"}},"dlcs":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/manifestEntry"}},"mods":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/manifestEntry"}}}},
    "pawnSummary":{"type":"object","additionalProperties":false,"required":["pawn","label"],"properties":{"pawn":{"$ref":"#/$defs/pawnId"},"label":{"$ref":"#/$defs/label"},"status":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/label"}}}},
    "need":{"type":"object","additionalProperties":false,"required":["label","level"],"properties":{"label":{"$ref":"#/$defs/label"},"level":{"type":"number","minimum":0,"maximum":1}}},
    "healthRow":{"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"$ref":"#/$defs/label"},"part":{"$ref":"#/$defs/label"}},"description":"Only audited normal health-card rows, missing ancestors and caller-gated blood loss; no raw summary percentage/severity."},
    "gear":{"type":"object","additionalProperties":false,"required":["label","slot"],"properties":{"label":{"$ref":"#/$defs/label"},"slot":{"enum":["apparel","equipment"]}}},
    "pawnDetail":{"type":"object","additionalProperties":false,"required":["pawn","label"],"properties":{"pawn":{"$ref":"#/$defs/pawnId"},"label":{"$ref":"#/$defs/label"},"status":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/label"}},"needs":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/need"}},"health":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/healthRow"}},"gear":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/gear"}},"job":{"$ref":"#/$defs/label"},"lordReport":{"$ref":"#/$defs/label"}}},
    "pawnData":{"type":"object","additionalProperties":false,"required":["sample","pawn"],"properties":{"sample":{"$ref":"#/$defs/mapSample"},"pawn":{"$ref":"#/$defs/pawnDetail"}}},
    "thing":{"type":"object","additionalProperties":false,"required":["thing","label","x","z"],"properties":{"thing":{"$ref":"#/$defs/thingId"},"label":{"$ref":"#/$defs/label"},"x":{"type":"integer","minimum":0,"maximum":4095},"z":{"type":"integer","minimum":0,"maximum":4095},"stackUnits":{"type":"integer","minimum":1,"maximum":2147483647}}},
    "page":{"type":"object","additionalProperties":false,"required":["sample","snapshot","basis","items","complete"],"properties":{"sample":{"$ref":"#/$defs/mapSample"},"snapshot":{"$ref":"#/$defs/pageCursor"},"basis":{"const":"eligible_observed_snapshot"},"items":{"type":"array","maxItems":64,"items":{"oneOf":[{"$ref":"#/$defs/pawnSummary"},{"$ref":"#/$defs/thing"}]}},"complete":{"type":"boolean"},"next":{"$ref":"#/$defs/pageCursor"}},"allOf":[{"if":{"properties":{"complete":{"const":false}}},"then":{"required":["next"]},"else":{"not":{"required":["next"]}}}],"description":"Items homogeneous by request method; no raw source count/index. Cursor binds method, scope, limit and immutable sanitized vector."},
    "resource":{"type":"object","additionalProperties":false,"required":["label","stackUnits"],"properties":{"label":{"$ref":"#/$defs/label"},"stackUnits":{"$ref":"#/$defs/counter"}}},
    "resources":{"type":"object","additionalProperties":false,"required":["sample","basis","items"],"properties":{"sample":{"$ref":"#/$defs/mapSample"},"basis":{"const":"eligible_observed_direct_spawned_stack_units"},"items":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/resource"}}}},
    "selection":{"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"$ref":"#/$defs/label"},"pawn":{"$ref":"#/$defs/pawnId"},"thing":{"$ref":"#/$defs/thingId"}},"not":{"required":["pawn","thing"]}},
    "window":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"$ref":"#/$defs/symbol"},"label":{"$ref":"#/$defs/label"}},"description":"Allowlisted window kind, not arbitrary runtime type/internal data."},
    "ui":{"type":"object","additionalProperties":false,"required":["sample"],"properties":{"sample":{"$ref":"#/$defs/sample"},"selection":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/selection"}},"windows":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/window"}}},"description":"No rendered controls until clipping/occlusion contract/audit implemented."},
    "screenshot":{"type":"object","additionalProperties":false,"required":["scope","capture","frame","phase","width","height","scale","encoding","bytes","chunks"],"properties":{"scope":{"$ref":"#/$defs/scope"},"capture":{"$ref":"#/$defs/capture"},"frame":{"$ref":"#/$defs/counter"},"phase":{"const":"completed_render"},"width":{"type":"integer","minimum":1,"maximum":1920},"height":{"type":"integer","minimum":1,"maximum":1080},"scale":{"type":"number","exclusiveMinimum":0,"maximum":8},"encoding":{"const":"png_base64_chunks"},"bytes":{"type":"integer","minimum":8,"maximum":3141632},"chunks":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"string","maxLength":16384,"pattern":"^[A-Za-z0-9+/]*={0,2}$"}}},"description":"Also <=2073600 pixels; join/decode chunks, verify PNG/length/dimensions; nonfinal chunks exactly 16384 chars, padding only final."},
    "event":{"type":"object","additionalProperties":false,"required":["kind","text"],"properties":{"kind":{"enum":["letter","message","lifecycle"]},"label":{"$ref":"#/$defs/label"},"text":{"type":"string","maxLength":2048}},"allOf":[{"if":{"properties":{"kind":{"const":"lifecycle"}}},"then":{"not":{"required":["label"]},"properties":{"text":{"enum":["observation_ready","scope_changed","observation_resumed"]}}}}],"description":"Only accepted sanitized public publications; no raw target/debugInfo/hidden attempt sequence. Lifecycle text is fixed bridge state, never game internals."},
    "eventPage":{"type":"object","additionalProperties":false,"required":["scope","items","next"],"properties":{"scope":{"$ref":"#/$defs/scope"},"items":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/event"}},"next":{"$ref":"#/$defs/eventCursor"}}}
  }
}
