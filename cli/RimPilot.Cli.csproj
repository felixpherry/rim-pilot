<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rim-pilot</AssemblyName>
    <RootNamespace>RimPilot.Cli</RootNamespace>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Keep bundled runtime and redistribution notices on the same explicit pin. -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <Import Project="../shared/Json/JsonDependency.props" />
  <Import Project="../shared/Protocol/Protocol.props" />
</Project>
